# First launch works without keys or external requests.
OFFICE_ENABLE_MODEL=false
OFFICE_MODEL_PROTOCOL=chat_completions
# Full Chat Completions endpoint. Do not put credentials in the URL.
OFFICE_MODEL_URL=https://api.openai.com/v1/chat/completions
OFFICE_MODEL_NAME=gpt-6.1-sol
# Paste your OpenAI project API key here in the ignored .env file only.
# AI Office and the optional OpenCode launcher share this server-side key.
OFFICE_MODEL_KEY=
# Anthropic requires max_tokens; this limit is used only for Messages requests.
OFFICE_MODEL_MAX_TOKENS=8192
OFFICE_MODEL_TIMEOUT_SECONDS=120

# Optional OpenCode setup; these variables are read by tools/opencode.py.
# OpenCode is a separate coding session, not an AI Office stage executor.
OPENCODE_PROVIDER=openai
OPENCODE_BASE_URL=https://api.openai.com/v1
OPENCODE_MODEL=openai/gpt-6.1-sol
# OpenCode uses small_model for lightweight internal work, such as titles.
# This does not automatically route AI Office stages to Luna.
OPENCODE_SMALL_MODEL=openai/gpt-6-luna

# Optional absolute paths; defaults are ./data and ./catalog.
# OFFICE_DATA_DIR=
# OFFICE_CATALOG_DIR=
# OFFICE_ALLOWED_ORIGINS=
