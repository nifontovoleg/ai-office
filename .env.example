# Primary workflow: Codex CLI with saved ChatGPT login (codex login).
# Copy this file to .env. Enable calls when ready to start real stages.
OFFICE_ENABLE_MODEL=false
OFFICE_MODEL_PROTOCOL=codex_cli
# Leave blank to use the CLI default; choose a model available to your account.
OFFICE_MODEL_NAME=
# Optional absolute path to the native executable if Codex is not in PATH.
OFFICE_CODEX_PATH=
OFFICE_CODEX_TIMEOUT_SECONDS=300

# Codex and free OpenCode modes ignore these optional API fields.
OFFICE_MODEL_URL=
OFFICE_MODEL_KEY=
OFFICE_MODEL_MAX_TOKENS=8192
OFFICE_MODEL_TIMEOUT_SECONDS=120

# OpenCode: Big Pickle through the public free Zen endpoint; no key/login.
# These variables are read by tools/opencode.py.
# OpenCode is a separate coding session, not an AI Office stage executor.
OPENCODE_PROVIDER=opencode
OPENCODE_AUTH=free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=opencode/big-pickle
# OpenCode uses small_model for lightweight internal work, such as titles.
# This does not automatically route AI Office stages to OpenCode.
OPENCODE_SMALL_MODEL=opencode/big-pickle

# Optional absolute paths; defaults are ./data and ./catalog.
# OFFICE_DATA_DIR=
# OFFICE_CATALOG_DIR=
# OFFICE_ALLOWED_ORIGINS=
