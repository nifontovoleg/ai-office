# Copy this file to the repository root as .env to use ProxyAPI.
# Do not overwrite an existing .env without preserving its local settings.
OFFICE_ENABLE_MODEL=false
OFFICE_MODEL_PROTOCOL=chat_completions
OFFICE_MODEL_URL=https://api.proxyapi.ru/v1/chat/completions
OFFICE_MODEL_NAME=openai/gpt-6.1-sol
# Paste a ProxyAPI key here, not an OpenAI key. Never commit .env.
OFFICE_MODEL_KEY=
OFFICE_MODEL_MAX_TOKENS=8192
OFFICE_MODEL_TIMEOUT_SECONDS=120

OPENCODE_PROVIDER=proxyapi
OPENCODE_BASE_URL=https://api.proxyapi.ru/v1
# The first prefix is the OpenCode provider; the remaining ID is ProxyAPI's.
OPENCODE_MODEL=proxyapi/openai/gpt-6.1-sol
OPENCODE_SMALL_MODEL=proxyapi/openai/gpt-6-luna

# OFFICE_DATA_DIR=
# OFFICE_CATALOG_DIR=
# OFFICE_ALLOWED_ORIGINS=
