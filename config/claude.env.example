# Copy to the repository root as .env for direct Claude Platform access.
OFFICE_ENABLE_MODEL=false
OFFICE_MODEL_PROTOCOL=anthropic_messages
OFFICE_MODEL_URL=https://api.anthropic.com/v1/messages
OFFICE_MODEL_NAME=claude-sonnet-5-5
# Paste your Claude Platform API key here, not a Claude chat subscription token.
OFFICE_MODEL_KEY=
OFFICE_MODEL_MAX_TOKENS=8192
OFFICE_MODEL_TIMEOUT_SECONDS=120

OPENCODE_PROVIDER=anthropic
OPENCODE_BASE_URL=https://api.anthropic.com/v1
OPENCODE_MODEL=anthropic/claude-sonnet-5-5
OPENCODE_SMALL_MODEL=anthropic/claude-haiku-5-5

# OFFICE_DATA_DIR=
# OFFICE_CATALOG_DIR=
# OFFICE_ALLOWED_ORIGINS=
